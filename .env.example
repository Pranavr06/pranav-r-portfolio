# ==============================================================================
# Environment Variables Example for Pranav R Portfolio & Personal CMS
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# NOTE: Never commit '.env.local' or expose real secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here

# Service Role Key (Required for server-side admin operations and rate limiting)
# WARNING: Keep this strictly confidential on the server; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Administrator Credentials
# ------------------------------------------------------------------------------
# Email authorized for administrative dashboard access and notifications
ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Bot Detection & Form Protection)
# ------------------------------------------------------------------------------
# Found in Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# Application Base URL (Optional / Production Redirects)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
